msgid "plugins.generic.disco.knowledgeBase.base"
msgstr "BASE"

msgid "plugins.generic.disco.knowledgeBase.base.description"
msgstr "Indexes the metadata of all kinds of academically relevant resources - journals, institutional repositories, digital collections, etc. - which provide an OAI interface and use OAI-PMH for providing their contents.<p><strong>Joining Process</strong></p><p>Suggest an OAI-PMH via an online form on the BASE website and Automated collection of OAI-PMH repository listed in directories</p>"

msgid "plugins.generic.disco.knowledgeBase.base.application"
msgstr "Become a content provider"

msgid "plugins.generic.disco.knowledgeBase.ceeol"
msgstr "CEEOL"

msgid "plugins.generic.disco.knowledgeBase.ceeol.description"
msgstr "The Central and Eastern European Online Library (CEEOL) is a repository of full text indexed documents in the fields of Humanities and Social Science publications from and about Central and Eastern Europe.<p><strong>Joining Process</strong></p><p>Completion of the online application form and evaluation by the CEEOL's publisher support team.</p>"

msgid "plugins.generic.disco.knowledgeBase.ceeol.application"
msgstr "Suggest for the application"

msgid "plugins.generic.disco.knowledgeBase.core"
msgstr "CORE"

msgid "plugins.generic.disco.knowledgeBase.core.description"
msgstr "CORE (COnnecting REpositories) provides a comprehensive bibliographic database of the world's scholarly literature, collecting and indexing research from repositories and journals. It is also the world's largest collection of full text open access research papers. CORE is a not-for-profit service dedicated to the open access mission and one of the signatories of the Principles of Open Scholarly Infrastructures.<p><strong>Joining Process</strong></p><p>Automatic harvest from a list of aggregators: <a href="https://core.ac.uk/data-providers/?q=&size=10" target="_blank">https://core.ac.uk/data-providers/?q=&size=10</a><br />Possibility to add a new data provider registration by completion of a form: <a target="_blank" href="https://core.ac.uk/benefits#join-core">https://core.ac.uk/benefits#join-core</a></p>"

msgid "plugins.generic.disco.knowledgeBase.core.application"
msgstr "Join CORE as a data provider"

msgid "plugins.generic.disco.knowledgeBase.crossref"
msgstr "Crossref"

msgid "plugins.generic.disco.knowledgeBase.crossref.description"
msgstr "Crossref is a membership organization with 19K members from commercial and institutional publishing. Crossref's main service is the linking of citing and cited publications. Participating publishers register Crossref DOIs and submit metadata of their own publications.<p><strong>Joining Process</strong></p><p>Membership is required to be registered by Crossref. Membership is open to either publishers or service providers.<br />Members can then issue Crossref DOIs for their users. DOI generation can vary from one service to another: automated/on-demand generation, for any content/specific content, etc.</p>"

msgid "plugins.generic.disco.knowledgeBase.crossref.application"
msgstr "Became a member"

msgid "plugins.generic.disco.knowledgeBase.ebsco"
msgstr "EBSCO"

msgid "plugins.generic.disco.knowledgeBase.ebsco.description"
msgstr "EBSCO is a provider of research databases, e-journals, and e-package subscription and acquisition management tools, and a provider of library technology and e-books. It provides its services to universities, colleges, hospitals, corporations, government, and public libraries worldwide. EBSCOHost is a closed service that provides access to full-text and includes EBSCO eBook Collection, EBSCO Academic Collection, and EBSCO eBook Open Access Collection. EBSCO Discovery Service (EDS) is another service providing bibliographic information about publications. EBSCO provides other services, such as AtoZ or Academic Search Ultimate. While operating mostly for institutions like libraries and universities, EBSCO also operates directly with journals and e-books publishers.<p><strong>Joining Process</strong></p><p>Publishers first contact the EBSCO Publishers Operation team to learn about indexing conditions and process at: <a target="_blank" href="https://www.ebsco.com/publishers-partnerships/journal-subscription-services/support">https://www.ebsco.com/publishers-partnerships/journal-subscription-services/support</a>.</p><p>First indexing request through a webform: <a target="_blank" href="https://www.ebsco.com/publishers-partnerships/full-text-licensed-databases-contact-form">https://www.ebsco.com/publishers-partnerships/full-text-licensed-databases-contact-form</a></p>"

msgid "plugins.generic.disco.knowledgeBase.ebsco.application"
msgstr "Suggest for application"

msgid "plugins.generic.disco.knowledgeBase.semanticscholar"
msgstr "Semantic Scholar"

msgid "plugins.generic.disco.knowledgeBase.semanticscholar.description"
msgstr "Semantic Scholar provides free, AI-driven search and discovery tools and open resources for the global research community. It indexes over 200 million academic papers sourced from publisher partnerships, data providers, and web crawls. AI features allow for abstract and citation analysis.<p><strong>Joining Process</strong></p><p>Semantic scholar mostly operates with big publishers and repositories.<br />Fully automated indexing process upon a list of academic publishers, data providers, and aggregators.<br />Possibility to submit as an author an article request by following this guide: <a target="_blank" href="https://www.semanticscholar.org/faq/add-papers-author-page">https://www.semanticscholar.org/faq/add-papers-author-page</a></p>"

msgid "plugins.generic.disco.knowledgeBase.doaj"
msgstr "DOAJ"

msgid "plugins.generic.disco.knowledgeBase.doaj.description"
msgstr "Community-curated list of peer-reviewed open access journals, maintained by Infrastructure Services for Open Access (IS4OA). DOAJ also allows for article metadata collection and display, and free distribution of journal and article metadata. <p><strong>Joining Process</strong></p>Publishers have to register and complete an online application form: <a target="_blank" href="https://doaj.org/account/login?redirected=apply">https://doaj.org/account/login?redirected=apply</a><br />The admission requires compliance with a set of editorial and technical requirements.</p>"

msgid "plugins.generic.disco.knowledgeBase.doaj.application"
msgstr "Suggest for application"

msgid "plugins.generic.disco.knowledgeBase.erihplus"
msgstr "ERIH+"

msgid "plugins.generic.disco.knowledgeBase.erihplus.description"
msgstr "ERIH+ is an online index holding bibliographic information on academic journals in the Social Sciences and Humanities (SSH), with a focus on quality journals across all European languages and countries. ERIH+ supports journals' policies of openness and transparency in line with editorial best practices. Curation ensures that journals' open access status and Plan S compliance are marked. ERIH+ offers an additional index of articles, which is an SSH subset of Dimensions collections, showing only articles having a DOI. Dimensions is a multidisciplinary database that brings together over 140 million publications.<p><strong>Joining Process</strong></p><p>New journals have to be submitted after creation of a user account: <a target="_blank" href="https://kanalregister.hkdir.no/publiseringskanaler/erihplus/login.action">https://kanalregister.hkdir.no/publiseringskanaler/erihplus/login.action</a><br />ERIH+ will not be evaluating journals submitted by publishers, members of the editorial board or others affiliated with a journal.</p>"

msgid "plugins.generic.disco.knowledgeBase.erihplus.application"
msgstr "Suggest for application"

msgid "plugins.generic.disco.knowledgeBase.gotriple"
msgstr "GoTriple"

msgid "plugins.generic.disco.knowledgeBase.gotriple.description"
msgstr "GoTriple is a multilingual discovery platform for the social sciences and humanities (SSH). It provides a comprehensive access point for discovering and reusing research artifacts that are relevant to the wide variety of disciplines under the umbrella domain of SSH: publications and research data, project descriptions, authors, and researcher profiles are automatically imported from aggregators and source providers, semantically enriched, and linked in GoTriple.<p><strong>Joining Process</strong></p><p>If the publications are not already stored in GoTriple's data sources, the main option is to register a new data source through the dedicated interface: <a target="_blank" href="https://pipeline.gotriple.eu/user/login?destination=/">https://pipeline.gotriple.eu/user/login?destination=/</a></p>."

msgid "plugins.generic.disco.knowledgeBase.gotriple.application"
msgstr "Become a content provider"

msgid "plugins.generic.disco.knowledgeBase.gs"
msgstr "Google Scholar"

msgid "plugins.generic.disco.knowledgeBase.gs.description"
msgstr "Searchable bibliographic index that displays full text and metadata of scholarly literature across an array of publishing formats and disciplines.<p><strong>Joining process</strong></p><p>Google Scholar uses automated software, known as "robots" or "crawlers", to fetch files for inclusion in the search results. The journal's website needs to be structured in a way that makes it possible to "crawl" in this manner. Automatic crawlers need to be able to discover and fetch the URLs of all articles, as well as to periodically refresh their content from the journal website.</p>"

msgid "plugins.generic.disco.knowledgeBase.openaire"
msgstr "OpenAIRE Graph"

msgid "plugins.generic.disco.knowledgeBase.openaire.description"
msgstr "The OpenAIRE Graph is an open resource that aggregates a collection of research data properties (metadata, links) available within the OpenAIRE Open Science infrastructure for funders, organizations, researchers, research communities, and publishers. It is made available via datasets published on Zenodo and searchable via OpenAIRE EXPLORE.<p><strong>Joining Process</strong></p><p>If the publications are not already stored in OpenAIRE's data source (full list of data sources here: <a target="_blank" href="https://explore.openaire.eu/search/find/dataproviders">https://explore.openaire.eu/search/find/dataproviders</a>), the main option is to register the data source via OpenAIRE PROVIDE (<a target="_blank" href="https://provide.openaire.eu/">https://provide.openaire.eu/</a>). The data source must be compliant with the OpenAIRE guidelines (<a target="_blank" href="https://guidelines.openaire.eu/">https://guidelines.openaire.eu/</a>).</p>"

msgid "plugins.generic.disco.knowledgeBase.openaire.application"
msgstr "Suggest for application"

msgid "plugins.generic.disco.knowledgeBase.openalex"
msgstr "OpenAlex"

msgid "plugins.generic.disco.knowledgeBase.openalex.description"
msgstr "Open catalog of scholarly works (journal articles, conference papers, books and book chapters, datasets, and theses), authors, and institutions. It includes connections between these works, finding associations through things like journals, authors, institutional affiliations, citations, concepts, and funders.<p><strong>Joining Process</strong></p><p>OpenAlex automatically indexes new journals and articles. If the publications are not already stored in OpenAlex data sources. OpenAlex primarily retrieves new records from Crossref (<a target="_blank" href="https://www.crossref.org/">https://www.crossref.org/</a>)."

msgid "plugins.generic.disco.knowledgeBase.pubmed"
msgstr "PubMed"

msgid "plugins.generic.disco.knowledgeBase.pubmed.description"
msgstr "PubMed is a free resource supporting the search and retrieval of biomedical and life sciences literature to improve health - both globally and personally. The PubMed database contains more than 37 million citations and abstracts of biomedical literature. It does not include full text journal articles; however, links to the full text are often present when available from other sources, such as the publisher's website or PubMed Central (PMC).<p><strong>Joining Process</strong></p><p>Completion of an application form for journal suggestion after registration on the platform. (<a target="_blank" href="https://www.ncbi.nlm.nih.gov/medline/publisherportal/">https://www.ncbi.nlm.nih.gov/medline/publisherportal/</a>)<br />Journals must successfully pass both a Scientific Quality Review and a Technical and Indexing Requirements Check to be indexed (more informations in the criteria documentation: <a target="_blank" href="https://www.nlm.nih.gov/medline/medline_how_to_include.html#scientificquality">https://www.nlm.nih.gov/medline/medline_how_to_include.html#scientificquality</a> .)</p>"

msgid "plugins.generic.disco.knowledgeBase.pubmed.application"
msgstr "Suggest for application"

msgid "plugins.generic.disco.knowledgeBase.scopus"
msgstr "Scopus"

msgid "plugins.generic.disco.knowledgeBase.scopus.description"
msgstr "Abstract and citation database that allows searching papers of peer-reviewed journals in different subject fields: life sciences, social sciences, physical sciences, and health sciences. It covers three types of sources: book series, journals, and trade journals. Scopus also allows patent searches in a dedicated patent database, Lexis-Nexis.<p><strong>Joining Process</strong></p><p>Application form for journal suggestion to the CSAB (Content Selection and Advisory Board): <a target="_blank" href="https://suggestor.step.scopus.com/suggestTitle/step1.cfm">https://suggestor.step.scopus.com/suggestTitle/step1.cfm</a> and compliance with a set of editorial and technical requirements.</p>"

msgid "plugins.generic.disco.knowledgeBase.scopus.application"
msgstr "Suggest for application"

msgid "plugins.generic.disco.knowledgeBase.wos"
msgstr "Web of Science (WoS)"

msgid "plugins.generic.disco.knowledgeBase.wos.description"
msgstr "The Web of Science (WoS) is a paid-access platform that provides access to multiple databases that provide reference and citation data from academic journals, conference proceedings, and other documents in various academic disciplines.<p><strong>Joining Process</strong></p><p>Acces governed by a 2-step process detailed here: <a target="_blank" href="https://clarivate.com/products/scientific-and-academic-research/research-publishing-solutions/publisher-portal/newusers/">https://clarivate.com/products/scientific-and-academic-research/research-publishing-solutions/publisher-portal/newusers/</a><br /> 1st step: Creation of a user account with your institutional email address: <a target="_blank" href="https://access.clarivate.com/register?app=wpp&referrer=%2Fwpp%2Fhom">https://access.clarivate.com/register?app=wpp&referrer=%2Fwpp%2Fhom</a><br />2nd step: Request access to the publisher portal: <a target="_blank" href="https://support.clarivate.com/ScientificandAcademicResearch/s/publisher-portal-access-request?language=en_US">https://support.clarivate.com/ScientificandAcademicResearch/s/publisher-portal-access-request?language=en_US</a></p>"

msgid "plugins.generic.disco.knowledgeBase.wos.application"
msgstr "Suggest for application"

msgid "plugins.generic.disco.knowledgeBase.google"
msgstr "Search Engine: Google"

msgid "plugins.generic.disco.knowledgeBase.google.description"
msgstr "Google uses automated ranking systems that <a href="https://www.google.com/search/howsearchworks/how-search-works/ranking-results/" target="_blank">look at many factors and signals</a> about hundreds of billions of web pages and other content in our Search index to present the most relevant, useful results, all in a fraction of a second. This page is a guide to understanding some of our more notable ranking systems. It covers some systems that are part of our core ranking systems, which are the underlying technologies that produce search results in response to queries. It also covers some systems involved with specific ranking needs."

msgid "plugins.generic.disco.knowledgeBase.yahoo"
msgstr "Search Engine: Yahoo! Search"

msgid "plugins.generic.disco.knowledgeBase.yahoo.description"
msgstr "Yahoo! Search is a search engine owned and operated by Yahoo!, using Microsoft Bing to power results."

msgid "plugins.generic.disco.knowledgeBase.bing"
msgstr "Search Engine: Microsoft Bing"

msgid "plugins.generic.disco.knowledgeBase.bing.description"
msgstr "Microsoft Bing (also known simply as Bing) is a search engine owned and operated by Microsoft. The service traces its roots back to Microsoft's earlier search engines, including MSN Search, Windows Live Search, and Live Search. Bing offers a broad spectrum of search services, encompassing web, video, image, and map search products, all developed using ASP.NET."

msgid "plugins.generic.disco.knowledgeBase.duckduckgo"
msgstr "Search Engine: DuckDuckGo"

msgid "plugins.generic.disco.knowledgeBase.duckduckgo.description"
msgstr "DuckDuckGo stands out from its competitors for many reasons other than its fun name and branding. While they do have fantastic marketing, DuckDuckGo affords you a level of privacy that most other search engines don't, can't, or are unwilling to match. Furthermore, understanding DuckDuckGo Search Engine Optimization (SEO) will enable you to tap into a larger audience. If that sounds like something you'd be interested in, let's talk about what makes DuckDuckGo unique and how you can optimize your website to appear in its search results!"

msgid "plugins.generic.disco.knowledgeBase.redalyc"
msgstr "REDALYC"

msgid "plugins.generic.disco.knowledgeBase.redalyc.description"
msgstr "Redalyc is an indexing system that contains open access journals of scientific and editorial quality. After 16 years of providing visibility and supporting the consolidation of journals, it now incorporates exclusively those journals, from any part of the world, that share the non-profit publishing model in order to preserve the scholarly and open nature of scientific communication."

msgid "plugins.generic.disco.knowledgeBase.redalyc.application"
msgstr "Suggest for application"

msgid "plugins.generic.disco.knowledgeBase.ddh"
msgstr "Diamond Discovery Hub"

msgid "plugins.generic.disco.knowledgeBase.ddh.description"
msgstr "The Diamond Discovery Hub (DDH) will be a comprehensive registry of institutionally published and scholar-led Open Access Journals in Europe. It will be implemented as a responsive and WCAG (Web Content Accessibility Guidelines) compliant website with a SEO friendly UI. It will be scalable as well as easy to maintain and extend in the future. The DDH will be a service that provides Diamond journals' data curated by an editorial team."

msgid "plugins.generic.disco.knowledgeBase.ddh.application"
msgstr "Suggest for application"

msgid "plugins.generic.disco.score"
msgstr "Score"

msgid "plugins.generic.disco.results.description"
msgstr "This page is designed to display scores for individual databases that require certain prerequisites for application submission, which are subsequently subject to evaluation. Since the Discoverability Companion tool is a self-assessment tool, it cannot guarantee that a journal will be evaluated by the service. The plugin serves only as an aid and a knowledge base. Below, you will also find additional databases that may not have any evaluation criteria but are still worth being aware of."

msgid "plugins.generic.disco.badges"
msgstr "Badges"

msgid "plugins.generic.disco.badges.description"
msgstr ""

msgid "plugins.generic.disco.badges.badgesAvailable"
msgstr "Allow Badges in the footer of the pages."

msgid "plugins.generic.disco.badges.badgesAvailable.description"
msgstr "The badges will be shown as a part of the footer on the journal's pages"

msgid "plugins.generic.disco.about.openToAllAuthors"
msgstr "<h3>Open to all authors:</h3><p>{$contextTitle} is committed to openness and inclusivity in scholarly publishing without author-facing charges for reading or publishing. We welcome submissions from all authors, regardless of their institutional affiliation, geographical location, or academic status. Submissions only must align with the aims and scope of the journal and meet the required quality standards once the reviewing process is completed.</p>"

msgid "plugins.generic.disco.about.communityOwned"
msgstr "<h3>Community-owned:</h3><p>{$contextTitle} is owned by {$publisherInstitution}, a {$organisationType} institution/organisation dedicated to advancing research and scholarship. The journal’s ownership and governance structure reflect its mission to support open and accessible academic publishing. We confirm that any commercial service providers involved in our operations only deal with service-related aspects of journal publishing. All content-related aspects of publishing, such as submission, peer review, acceptance, publication frequency, and scope of the journal, are controlled by the editors / the owners of the journal.</p>"

msgid "plugins.generic.disco.diamond.organisationType"
msgstr "Choose the type of your institution/organisation:"

msgid "plugins.generic.disco.diamond.organisationType.public"
msgstr "public"

msgid "plugins.generic.disco.diamond.organisationType.nonProfit"
msgstr "not-for-profit"

msgid "plugins.generic.disco.badges.availableContent"
msgstr "📖 Content Freely Available"

msgid "plugins.generic.disco.badges.availableContent.description"
msgstr "Articles and other content of the journal are accessible to the public without restrictions or paywalls."

msgid "plugins.generic.disco.badges.communityOwned"
msgstr "🌱 Community-Owned"

msgid "plugins.generic.disco.badges.communityOwned.description"
msgstr "The journal is managed and owned by an academic or professional community rather than a commercial publisher."

msgid "plugins.generic.disco.badges.diamondJournal"
msgstr "💎 Diamond Open Access"

msgid "plugins.generic.disco.badges.diamondJournal.description"
msgstr "The journal charges neither authors nor readers — it is fully funded by alternative means."

msgid "plugins.generic.disco.badges.doiUsed"
msgstr "🔗 DOI Assigned"

msgid "plugins.generic.disco.badges.doiUsed.description"
msgstr "Articles are assigned Digital Object Identifiers (DOIs) for persistent linking and easy citation."

msgid "plugins.generic.disco.badges.geographicalDiversity"
msgstr "🌍 Geographical Diversity"

msgid "plugins.generic.disco.badges.geographicalDiversity.description"
msgstr "The editorial board and authors come from various regions of the world, fostering inclusiveness and international collaboration."

msgid "plugins.generic.disco.badges.noApc"
msgstr "🚫 No Author Fees"

msgid "plugins.generic.disco.badges.noApc.description"
msgstr "Authors are not required to pay any fees to publish their articles in the journal."

msgid "plugins.generic.disco.badges.openToAllAuthors"
msgstr "✍️ Open to All Authors"

msgid "plugins.generic.disco.badges.openToAllAuthors.description"
msgstr "The journal welcomes submissions from all authors regardless of country, institutional affiliation, or status."

msgid "plugins.generic.disco.badges.plagiarismCheckImplemented"
msgstr "🔍 Plagiarism Check Implemented"

msgid "plugins.generic.disco.badges.plagiarismCheckImplemented.description"
msgstr "The journal uses tools to detect plagiarism and ensure the originality of published articles."

msgid "plugins.generic.disco.badges.regularPeriodicity"
msgstr "📅 Regular Publication Schedule"

msgid "plugins.generic.disco.badges.regularPeriodicity.description"
msgstr "The journal is published on a regular and predictable schedule, which enhances its credibility."

msgid "plugins.generic.disco.badges.scholarlyJournal"
msgstr "🎓 Scholarly Journal"

msgid "plugins.generic.disco.badges.scholarlyJournal.description"
msgstr "The journal meets academic publishing standards and contributes to the advancement of its disciplines."

msgid "plugins.generic.disco.requirements"
msgstr "Requirements"

msgid "plugins.generic.disco.serviceDescription"
msgstr "Service Description"
