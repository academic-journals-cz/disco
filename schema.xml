<schema version="0.2">
    
        <!--
	 *
	 * TABLE disco_plugin
	 *
	 -->
	<table name="disco_plugin">
		<field name="disco_id" type="I8">
			<KEY/>
			<AUTOINCREMENT/>
		</field>
		<field name="context_id" type="I8">
			<NOTNULL/>
		</field>
		<descr>List of disco items for each context by categories</descr>
	</table>
	<!--
	  *
	  * TABLE disco_plugin_settings
	  *
	  -->
	<table name="disco_plugin_settings">
                <field name="disco_id" type="I8">
			<NOTNULL/>
		</field>
                <field name="locale" type="C2" size="14">
			<NOTNULL/>
		</field>
		<field name="setting_name" type="C2" size="255">
			<NOTNULL/>
		</field>
		<field name="setting_value" type="X">
                    <NOTNULL/>
		</field>
                <field name="setting_type" type="C2" size="6">
			<NOTNULL/>
			<descr>(bool|int|float|string|object)</descr>
		</field>
		<descr>Discoverability companion settings.</descr>
		<index name="disco_plugin_settings_pkey">
			<col>disco_id</col>
			<col>locale</col>
			<col>setting_name</col>
			<UNIQUE />
		</index>
	</table>
</schema>
